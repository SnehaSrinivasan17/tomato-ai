GROQ_API_KEY = "replace_with_your_groq_api_key"
QDRANT_URL = "https://your-cluster.qdrant.io"
QDRANT_API_KEY = "replace_with_your_qdrant_api_key"

# Durable Cloud review storage. Use the real URI only in private secrets.
REVIEW_DATABASE_URL = "postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
REVIEW_STORAGE_BACKEND = "postgresql"
REVIEW_DB_NAMESPACE = "tomato"

# Optional standby; used only after primary authentication failure (HTTP 401).
GROQ_FALLBACK_API_KEY = ""
